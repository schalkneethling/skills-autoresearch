       </thead>\n        <tbody>\n            <tr>\n                <td>Sarah Johnson</td>\n                <td>Engineering</td>\n                <td>Senior Software Engineer</td>\n                <td>2021-03-15</td>\n                <td>Active</td>\n            </tr>\n            <tr>\n                <td>Michael Chen</td>\n                <td>Product</td>\n                <td>Product Manager</td>\n                <td>2022-01-10</td>\n                <td>Active</td>\n            </tr>\n            <tr>\n                <td>Emily Rodriguez</td>\n                <td>Marketing</td>\n                <td>Marketing Specialist</td>\n                <td>2022-06-01</td>\n                <td>On Leave</td>\n            </tr>\n            <tr>\n                <td>David Williams</td>\n                <td>Engineering</td>\n                <td>DevOps Engineer</td>\n                <td>2020-11-20</td>\n                <td>Active</td>\n            </tr>\n            <tr>\n                <td>Jessica Lee</td>\n                <td>Sales</td>\n                <td>Account Executive</td>\n                <td>2021-09-05</td>\n                <td>Active</td>\n            </tr>\n            <tr>\n                <td>Robert Martinez</td>\n                <td>Finance</td>\n                <td>Financial Analyst</td>\n                <td>2019-05-14</td>\n                <td>Departed</td>\n            </tr>\n            <tr>\n                <td>Amanda Foster</td>\n                <td>Human Resources</td>\n                <td>HR Manager</td>\n                <td>2020-08-03</td>\n                <td>Active</td>\n            </tr>\n            <tr>\n                <td>James Patterson</td>\n                <td>Engineering</td>\n                <td>QA Engineer</td>\n                <td>2023-02-20</td>\n                <td>Active</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <!-- Summary and pagination -->\n    <p>Showing 8 of 42 employees</p>\n\n    <nav aria-label=\"Pagination\"