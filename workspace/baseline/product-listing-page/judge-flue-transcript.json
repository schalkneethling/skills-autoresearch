egory\" value=\"womens\">\n                                Women's\n                            </label>\n                        </div>\n                        <div>\n                            <label>\n                                <input type=\"checkbox\" name=\"category\" value=\"kids\">\n                                Kids'\n                            </label>\n                        </div>\n                    </fieldset>\n\n                    <!-- In Stock Only Toggle -->\n                    <fieldset>\n                        <legend>Availability</legend>\n                        <div>\n                            <label>\n                                <input type=\"checkbox\" name=\"instock\" value=\"yes\">\n                                In Stock Only\n                            </label>\n                        </div>\n                    </fieldset>\n\n                    <button type=\"submit\">Apply Filters</button>\n                </form>\n            </aside>\n\n            <!-- Product Cards Section -->\n            <section>\n                <h2>Available Products</h2>\n                <ul style=\"list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem;\">\n                    <!-- Product 1 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/ultra-runner-pro.jpg\" alt=\"Ultra Runner Pro shoes\">\n                            <h3>Ultra Runner Pro</h3>\n                            <p>High-performance racing shoe with responsive cushioning</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$129.99</span>\n                            </p>\n                            <button type=\"button\">Add Ultra Runner Pro to cart</button>\n                        </article>\n                    </li>\n\n                    <!-- Product 2 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/comfort-stride.jpg\" alt=\"Comfort Stride shoes\">\n                            <h3>Comfort Stride</h3>\n                            <p>Everyday training shoe with excellent arch support</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$89.99</span>\n                            </p>\n                            <button type=\"button\">Add Comfort Stride to cart</button>\n                        </article>\n                    </li>\n\n                    <!-- Product 3 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/trail-blazer.jpg\" alt=\"Trail Blazer shoes\">\n                            <h3>Trail Blazer</h3>\n                            <p>Rugged off-road running shoe with superior grip</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$119.99</span>\n                            </p>\n                            <button type=\"button\">Add Trail Blazer to cart</button>\n                        </article>\n                    </li>\n\n                    <!-- Product 4 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/sprint-elite.jpg\" alt=\"Sprint Elite shoes\">\n                            <h3>Sprint Elite</h3>\n                            <p>Lightweight sprinting shoe designed for speed</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$139.99</span>\n                            </p>\n                            <button type=\"button\">Add Sprint Elite to cart</button>\n                        </article>\n                    </li>\n\n                    <!-- Product 5 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/marathon-max.jpg\" alt=\"Marathon Max shoes\">\n                            <h3>Marathon Max</h3>\n                            <p>Long-distance running shoe with maximum durability</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$109.99</span>\n                            </p>\n                            <button type=\"button\">Add Marathon Max to cart</button>\n                        </article>\n                    </li>\n\n                    <!-- Product 6 -->\n                    <li>\n                        <article>\n                            <img src=\"/images/junior-runner.jpg\" alt=\"Junior Runner shoes\">\n                            <h3>Junior Runner</h3>\n                            <p>Kids' running shoe with fun colors and comfortable fit</p>\n                            <p>\n                                <span>Price: </span>\n                                <span>$64.99</span>\n                            </p>\n                            <button type=\"button\">Add Junior Runner to cart</button>\n                        </article>\n                    </li>\n                </ul>\n            </section>\n        </div>\n    </main>\n\n    <!-- Site Footer -->\n    <footer>\n        <div>\n            <section>\n                <h2>Contact Information</h2>\n                <p>Email: <a href=\"mailto:support@sportgear.com\">support@sportgear.com</a></p>\n                <p>Phone: <a href=\"tel:+1-800-555-0123\">1-800-555-0123</a></p>\n                <p>Address: 123 Athletic Way, Portland, OR 97214</p>\n            </section>\n\n            <section>\n                <h2>Quick Links</h2>\n                <nav aria-label=\"Footer\">\n                    <ul>\n                        <li><a href=\"/about\">About Us</a></li>\n                        <li><a href=\"/shipping\">Shipping Info</a></li>\n                        <li><a href=\"/returns\">Returns Policy</a></li>\n                        <li><a href=\"/privacy\">Privacy Policy</a></li>\n                        <li><a href=\"/terms\">Terms of Service</a></li>\n                    </ul>\n                </nav>\n            </section>\n\n            <p>&copy; 2025 SportGear. All rights reserved.</p>\n        </div>\n    </footer>\n</body>\n</html>\n```\n\nScore only the producer output. Do not award credit for requirements merely stated in the skill instructions.\nReturn only well-formed JSON matching the EvalScore schema. Do not include markdown, code fences, prose, or XML tags:\n```json\n{\n  \"eval_id\": \"product-listing-page\",\n  \"eval_type\": \"generate-semantic-html\",\n  \"track_id\": \"html\",\n  \"total_score\": 0,\n  \"max_score\": 15,\n  \"dimensions\": [\n    {\n      \"id\": \"element_choice\",\n      \"score\": 0,\n      \"max_score\": 3,\n      \"rationale\": \"Rationale grounded only in the producer output.\"\n    },\n    {\n      \"id\": \"landmark_structure\",\n      \"score\": 0,\n      \"max_score\": 3,\n      \"rationale\": \"Rationale grounded only in the producer output.\"\n    },\n    {\n      \"id\": \"heading_hierarchy\",\n      \"score\": 0,\n      \"max_score\": 3,\n      \"rationale\": \"Rationale grounded only in the producer output.\"\n    },\n    {\n      \"id\": \"list_semantics\",\n      \"score\": 0,\n      \"max_score\": 3,\n      \"rationale\": \"Rationale grounded only in the producer output.\"\n    },\n    {\n      \"id\": \"aria_discipline\",\n      \"score\": 0,\n      \"max_score\": 3,\n      \"rationale\": \"Rationale grounded only in the producer output.\"\n    }\n  ],\n  \"summary\": \"Concise scoring summary.\"\n}\n```"
